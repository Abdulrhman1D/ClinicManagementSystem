@using ClinicManagementSystem.Application.Dtos
@model IEnumerable<SpecialtyDto>

@{
    ViewData["Title"] = "Specialties";
}

<div class="container">
    <h1>Specialties</h1>

    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary">
            Add New
        </a>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var specialty in Model)
            {
                <tr>
                    <td>@specialty.Id</td>
                    <td>@specialty.Name</td>
                    <td>
                        <a asp-action="Edit"
                           asp-route-uuid="@specialty.Uuid"
                           class="btn btn-warning">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-uuid="@specialty.Uuid"
                           class="btn btn-danger">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}