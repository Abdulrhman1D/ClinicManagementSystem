@using ClinicManagementSystem.Application.Dtos
@model IEnumerable<JobDto>

<div class="container">
    <h1>Jobs</h1>

    <div class="text-end">
        <a asp-action="Create"
           class="btn btn-primary">
            Add New
        </a>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var job in Model)
            {
                <tr>
                    <td>@job.Id</td>
                    <td>@job.Name</td>
                    <td>
                        <a asp-action="Edit"
                           asp-route-uuid="@job.Uuid"
                           class="btn btn-warning">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-uuid="@job.Uuid"
                           class="btn btn-danger">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>