@using ClinicManagementSystem.Application.Dtos
@model IEnumerable<DoctorDto>

<div class="container">
    <h2>Doctors</h2>

    <div class="text-end">
        <a asp-action="Create"
           class="btn btn-primary">
            Add New
        </a>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Phone</th>
                <th>Specialty</th>
                <th>Job</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var doctor in Model)
            {
                <tr>
                    <td>@doctor.Id</td>
                    <td>@doctor.Name</td>
                    <td>@doctor.Phone</td>
                    <td>@doctor.SpecialtyName</td>
                    <td>@doctor.JobName</td>
                    <td>
                        <a asp-action="Edit"
                           asp-route-uuid="@doctor.Uuid"
                           class="btn btn-warning">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-uuid="@doctor.Uuid"
                           class="btn btn-danger">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>