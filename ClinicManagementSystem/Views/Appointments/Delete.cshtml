@using ClinicManagementSystem.Application.Dtos
@model AppointmentDto

@{
    ViewData["Title"] = "Delete Appointment";
}

<div class="container">
    <h1>Delete Appointment</h1>

    <p>Are you sure you want to delete this appointment?</p>

    <form asp-action="Delete" asp-route-uuid="@Model.Uuid" method="post">

        <div class="form-group">
            <label>Patient</label>
            <input value="@Model.PatientName" class="form-control" readonly />
        </div>

        <div class="form-group">
            <label>Doctor</label>
            <input value="@Model.DoctorName" class="form-control" readonly />
        </div>

        <div class="form-group">
            <label asp-for="AppointmentDate">
                Appointment Date
            </label>

            <input asp-for="AppointmentDate" class="form-control" readonly />
        </div>

        <div class="form-group"> 
            <label asp-for="Status"></label>
            <input asp-for="Status" class="form-control" readonly />
        </div>

        <div class="form-group">
            <label asp-for="Notes"></label>
            <textarea asp-for="Notes" class="form-control" readonly></textarea>
        </div>

        <br />

        <input type="submit" value="Delete" class="btn btn-danger" />
    </form>

    <a asp-action="Index">Back to List</a>
</div>