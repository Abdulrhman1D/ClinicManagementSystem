@using ClinicManagementSystem.Application.Dtos
@model IEnumerable<AppointmentDto>
<div class="container">
    <h2>Appointments</h2>
    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary">Add New</a>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Patient</th>
                <th>Doctor</th>
                <th>Appointment Date</th>
                <th>Status</th>
                <th>Notes</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var appointment in Model)
            {
                <tr>
                    <td>@appointment.Id</td>
                    <td>@appointment.PatientName</td>
                    <td>@appointment.DoctorName</td>
                    <td>
                        @appointment.AppointmentDate.ToString("dd/MM/yyyy HH:mm",System.Globalization.CultureInfo.InvariantCulture)
                    </td>
                    <td>@appointment.Status</td>
                    <td>@appointment.Notes</td>
                    <td>
                        <a asp-controller="Appointments" asp-action="Edit" asp-route-uuid="@appointment.Uuid" class="btn btn-warning">
                            Edit
                        </a>
                        <a asp-controller="Appointments" asp-action="Delete" asp-route-uuid="@appointment.Uuid" class="btn btn-danger">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>